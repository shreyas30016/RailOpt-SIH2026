# ==============================================================================
# RailOpt — Environment Configuration Template
# Duplicate this file to .env for local development.
# NEVER commit .env to GitHub.
# ==============================================================================

# Frontend Configuration (Vercel / External Hosting)
# Set to your deployed FastAPI backend URL (e.g. https://railopt-api.onrender.com)
# Leave blank for local relative calls or same-origin deployment
API_BASE_URL=

# Backend CORS Configuration
# Comma-separated list of allowed origins (e.g. https://railopt.vercel.app,http://localhost:8000)
CORS_ORIGINS=

# Database Persistence
# Default: local SQLite (railopt.db). For production, provide a persistent PostgreSQL URL
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# OR-Tools CP-SAT Solver Configuration
# Execution timeout budget in seconds (default: 15)
SOLVER_TIMEOUT_SECONDS=

# Train Data Feed Configuration
# Options: auto (default), live, mock
TRAIN_DATA_PROVIDER=
LIVE_TRAIN_API_URL=
LIVE_TRAIN_API_KEY=
TRAIN_CACHE_TTL_SECONDS=

# AI Copilot Configuration
# Options: mock (default for offline judging), nvidia, anthropic, openai, gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
