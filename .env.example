# Database & API Configuration
DATABASE_URL=sqlite:///./railopt.db
SUPABASE_URL=
SUPABASE_KEY=

# Solver Configuration
SOLVER_TIMEOUT_SECONDS=15

# Live/Public Train Data Configuration
# Set TRAIN_DATA_PROVIDER to 'auto', 'live', or 'mock'
TRAIN_DATA_PROVIDER=auto
LIVE_TRAIN_API_URL=https://api.railwayapi.com/v2/
LIVE_TRAIN_API_KEY=
TRAIN_CACHE_TTL_SECONDS=60

# AI Copilot Configuration (Sprint AI-FOUNDATION)
# Leave AI_PROVIDER=mock for offline/SIH judging without an API key.
# Set AI_PROVIDER=nvidia and add your NVIDIA NIM free API key to enable live AI.
#
# Get a free NVIDIA API key at: https://build.nvidia.com
#
AI_PROVIDER=mock
# AI_PROVIDER=nvidia

AI_API_KEY=
# AI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

AI_MODEL=mock-model
# AI_MODEL=deepseek-ai/deepseek-v4-flash-0731
# AI_MODEL=meta/llama-3.1-70b-instruct
# AI_MODEL=mistralai/mixtral-8x7b-instruct

# AI_BASE_URL=
# Default NVIDIA NIM base URL: https://integrate.api.nvidia.com/v1
